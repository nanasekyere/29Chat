{
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "dependencies": {
    "@types/cookie-parser": "^1.4.10",
    "amqplib": "^0.10.9",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.1",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "http-proxy-middleware": "^3.0.5",
    "ioredis": "^5.10.0",
    "jsonwebtoken": "^9.0.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.18.0",
    "socket.io": "^4.8.3",
    "winston": "^3.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-signature": "^1.1.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/http-proxy-middleware": "^0.19.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/ms": "^2.1.0",
    "@types/node": "^25.0.10",
    "@types/passport": "~1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "~1.0.38",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^6.0.3",
    "cookie-signature": "^1.2.2",
    "dotenv": "^17.2.4",
    "drizzle-kit": "^0.31.8",
    "supertest": "^7.2.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "scripts": {
    "build": "npm run build:packages && npm run build:services",
    "build:packages": "npm run build:common && npm run build:database",
    "build:common": "tsc -p packages/common/tsconfig.json",
    "build:database": "tsc -p packages/database/tsconfig.json",
    "build:services": "npm run build:api-gateway && npm run build:auth-service && npm run build:chat-service && npm run build:message-storage-service && npm run build:presence-service",
    "build:api-gateway": "tsc -p services/api-gateway/tsconfig.json",
    "build:auth-service": "tsc -p services/auth-service/tsconfig.json",
    "build:chat-service": "tsc -p services/chat-service/tsconfig.json",
    "build:message-storage-service": "tsc -p services/message-storage-service/tsconfig.json",
    "build:presence-service": "tsc -p services/presence-service/tsconfig.json",
    "postinstall": "typesync || true",
    "test": "npm test --workspaces --if-present",
    "test:all": "vitest run --workspace vitest.workspace.ts"
  }
}
